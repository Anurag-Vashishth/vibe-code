---
import Layout from '../components/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { projects } from '../data/projects.js';
---
<Layout title="Pete McPherson — I Make Things" description="Meet Pete McPherson, explore his projects, and find his weekly newsletter about ideas and lessons from building." path="/">
  <section class="wrap hero home-hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="brand-dot" aria-hidden="true"></span>Hey, I'm Pete McPherson</p>
      <h1>I make<br /><em>things.</em></h1>
      <p class="lede">Hey, I'm Pete. I build interesting projects, explore new ideas, and share what I learn along the way.</p>
      <div class="hero-actions">
        <a class="button button-dark" href="/projects">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/about">More about me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-disc"></div>
      <div class="hero-monogram">P<span>.</span></div>
      <span class="hero-cross top-cross">+</span><span class="hero-cross bottom-cross">+</span>
    </div>
  </section>
  <section class="intro section">
    <div class="wrap split">
      <h2>A little<br />about me<span class="accent">.</span></h2>
      <div>
        <p class="lede">I'm Pete McPherson. I enjoy building useful things, experimenting with ideas, and turning curiosity into meaningful projects. This is where I share my work, experiences, and lessons learned.</p>
        <a class="text-link" href="/about">Read my story <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="wrap section">
    <h2>Selected work<span class="accent">.</span></h2>
    <div class="project-grid featured">{projects.slice(0, 3).map((project) => <ProjectCard project={project} />)}</div>
    <a class="text-link all-projects" href="/projects">View all projects <span aria-hidden="true">→</span></a>
  </section>
  <NewsletterForm />
</Layout>
