---
const { project, eager = false } = Astro.props;
---
<article class="project-card">
  <img src={project.image} alt={project.alt} width={720} height={450} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  <p class="eyebrow">{project.category}</p>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  {project.url
    ? <a class="text-link" href={project.url} aria-label={`Visit ${project.title}`}>Visit project ↗</a>
    : <span class="project-placeholder">Project link coming soon</span>}
</article>
